datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AdminRole {
  SUPER_ADMIN
  CONTENT_ADMIN
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

model Admin {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  name         String
  role         AdminRole      @default(CONTENT_ADMIN)
  avatar       String?
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  sessions     AdminSession[]

  @@map("admins")
}

model AdminSession {
  id        String   @id @default(uuid())
  adminId   String
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

model Category {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  description  String?
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@map("categories")
}

model WoodType {
  id              String    @id @default(uuid())
  slug            String    @unique
  name            String
  scientificName  String?
  rarity          String?
  description     String?
  origin          String?
  characteristics String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@map("wood_types")
}

model Product {
  id           String         @id @default(uuid())
  code         String         @unique
  slug         String         @unique
  name         String
  categoryId   String
  woodTypeId   String
  description  String?
  status       ContentStatus  @default(PUBLISHED)
  isFeatured   Boolean        @default(false)
  displayOrder Int            @default(0)
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  woodType     WoodType       @relation(fields: [woodTypeId], references: [id], onDelete: Restrict)
  sizes        ProductSize[]
  images       ProductImage[]
  postProducts PostProduct[]

  @@index([categoryId])
  @@index([woodTypeId])
  @@index([status])
  @@index([isFeatured])
  @@map("products")
}

model ProductSize {
  id           String   @id @default(uuid())
  productId    String
  size         String
  price        Decimal? @db.Decimal(12, 0)
  isAvailable  Boolean  @default(true)
  displayOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_sizes")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  url          String
  publicId     String?
  altText      String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Post {
  id              String        @id @default(uuid())
  slug            String        @unique
  title           String
  excerpt         String?
  content         String        @db.Text
  thumbnail       String?
  category        String
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?
  views           Int           @default(0)
  authorName      String        @default("Nghệ nhân Đông Phong")
  readTime        Int           @default(5)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  relatedProducts PostProduct[]

  @@index([slug])
  @@index([category])
  @@index([status])
  @@map("posts")
}

model PostProduct {
  id        String @id @default(uuid())
  postId    String
  productId String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([postId, productId])
  @@map("post_products")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Media {
  id        String   @id @default(uuid())
  publicId  String   @unique
  url       String
  filename  String
  format    String
  bytes     Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@map("media")
}
