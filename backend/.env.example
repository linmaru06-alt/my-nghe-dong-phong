# Environment & Server
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://mynghedongphong.vn

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mynghedongphong?schema=public"

# Redis Cache & Session
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="dongphong_super_secure_jwt_access_secret_key_2025"
JWT_REFRESH_SECRET="dongphong_super_secure_jwt_refresh_secret_key_2025"
JWT_ACCESS_EXPIRE="15m"
JWT_REFRESH_EXPIRE="7d"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME="dongphong-craft"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret_here"

# Seed Admin User
ADMIN_EMAIL="admin@dongphong.vn"
# bcrypt hash for "DongPhong@2025!"
ADMIN_PASSWORD_HASH="$2a$10$7Z2vY5QkP9X0hN3W7eG1cuB1H8J1Y3K2J-uEGWdKg-2wNgBA.example"

# Brand Contact & Zalo
ZALO_PHONE="0912345678"
CONTACT_PHONE="0912 345 678"

# Limits & Cache
MAX_FILE_SIZE=5242880
MAX_FILES_PER_PRODUCT=10
CACHE_TTL=300
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
